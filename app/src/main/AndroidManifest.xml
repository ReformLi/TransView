<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：INTERNET 供局域网 HTTP 服务器（NanoHTTPD）与 Coil 加载缩略图。
         · ACCESS_NETWORK_STATE：本工程代码并未使用（全工程无 ConnectivityManager），但
           media3-common / media3-exoplayer 各自声明了它（见 manifest 合并报告），删掉本行
           APK 里照样存在，且 Coil 的 RealNetworkObserver 正依赖它 —— 不再重复声明。
         · ACCESS_WIFI_STATE：曾是 NetUtils.wifiManager() 的需要，该方法已确认是死代码
           （全工程零调用）并一并删除；且新系统上无定位权限时 getConnectionInfo() 的 SSID
           恒为空占位值，本就无价值。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启（设置页可开关；仅用于拉起文件服务器前台服务） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 存储：API 30+ 用「所有文件访问」授权；API 21-29 用传统读写权限 + legacy 标记 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 电视特性声明（非强制，保证也能装到普通设备） -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".TransViewApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TransView">

        <!-- ⚠️ 临时「安全网」，有保质期（API 37 失效），不是长久方案 ——
             Android 16（API 36）起，最小宽度 >= 600dp 的屏幕（平板 / 大折叠内屏 / 桌面窗口模式）
             会**忽略** screenOrientation：本应用三个 Activity 都锁了 landscape，届时会被强制
             允许竖屏 / 任意尺寸窗口，顶部导航栏（非紧凑态约需 1050dp）会被挤出屏幕。
             本属性让系统在 API 36 上继续尊重旧的横竖屏 / 尺寸限制。
             为什么不能只靠它：① API 37 会移除本 opt-out；② 官方明确「桌面窗口模式下屏幕方向
             限制即便 opt-out 也会被覆盖」。因此代码侧已同步做宽度自适应 + configChanges 兜底
             （见 MainScreen 的 topBarTight 与 MainActivity 的 configChanges）。 -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!-- 与 PlayerActivity / ImageViewerActivity 保持一致：自行处理配置变更，不重建 Activity。
             Android 16 起大屏（sw >= 600dp）方向锁可能被忽略，旋转 / 改窗口尺寸会真正发生；
             此前本 Activity 未声明 configChanges，旋转会重建并丢掉 showSettings 等普通 remember 状态。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.TransView">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 电视桌面图标入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.TransView.Fullscreen" />

        <activity
            android:name=".ui.image.ImageViewerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.TransView.Fullscreen" />

        <!-- 前台服务类型：
             · specialUse —— API 34+ 运行时实际使用。Android 15 起禁止 dataSync 类型前台服务
               从 BOOT_COMPLETED 启动（ForegroundServiceStartNotAllowedException），specialUse
               不受该限制；且 dataSync 在 Android 15 上有 6 小时/天的时长上限，不适合常驻服务器。
             · dataSync —— 仅作 API 29~33 的回退（那些版本没有 specialUse，也没有 BOOT 限制）。 -->
        <service
            android:name=".service.ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="lan_http_file_server" />
        </service>

        <!-- 开机自启：BOOT_COMPLETED 由系统发送，需 exported=true；
             是否真正启动服务器由设置项 bootAutostart 决定 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
